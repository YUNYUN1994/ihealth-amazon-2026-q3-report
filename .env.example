# 独立应用运行配置（不要提交真实值）
NODE_ENV=production
TZ=Asia/Shanghai
APP_SLUG=ihealth-q3-report
APP_BASE_PATH=/apps/ihealth-q3-report/
HOST=127.0.0.1
PORT=8775
FEISHU_APP_ID=replace_with_shared_feishu_app_id
FEISHU_APP_SECRET=replace_with_shared_feishu_app_secret
FEISHU_SOURCES_FILE=/etc/ihealth-apps/ihealth-q3-report.feishu.json
APP_DATA_DIR=/var/lib/ihealth-apps/ihealth-q3-report
FEISHU_TIMEOUT_MS=30000
