{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.1",
  "envId": "{{env.TCB_ENV_ID}}",
  "region": "{{env.TCB_REGION}}",
  "functionRoot": ".",
  "functions": [
    {
      "name": "ihealth-amazon-report-api",
      "description": "iHealth Amazon Q3 report API：读取飞书并刷新报表",
      "type": "Event",
      "runtime": "Nodejs22.21",
      "handler": "cloudbase-report-api.main",
      "dir": ".",
      "timeout": 60,
      "memorySize": 512,
      "installDependency": false,
      "public": false,
      "envVariables": {
        "FEISHU_APP_ID": "{{env.FEISHU_APP_ID}}",
        "FEISHU_APP_SECRET": "{{env.FEISHU_APP_SECRET}}",
        "FEISHU_SPREADSHEET_TOKEN": "{{env.FEISHU_SPREADSHEET_TOKEN}}"
      },
      "ignore": [
        ".git",
        ".git/**/*",
        "node_modules",
        "node_modules/**/*",
        ".env",
        ".env.*",
        "!.env.example",
        "cloudbaserc.schema.json"
      ]
    }
  ],
  "hosting": [
    {
      "name": "ihealth-amazon-report-web",
      "root": ".",
      "framework": "static",
      "installCommand": "",
      "buildCommand": "",
      "outputDir": ".",
      "entryFile": ["index.html"],
      "verify": true,
      "safe": true,
      "prune": true,
      "ignore": [
        ".git",
        ".git/**/*",
        "node_modules",
        "node_modules/**/*",
        ".env",
        ".env.*",
        "!.env.example",
        "cloudbaserc.schema.json",
        "data",
        "data/**/*",
        "lib",
        "lib/**/*",
        "api",
        "api/**/*",
        "cloudbase-report-api.mjs",
        "cloudbaserc.json",
        "README.md",
        "package.json",
        "package-lock.json"
      ]
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/api/refresh",
        "target": "function:ihealth-amazon-report-api",
        "protocol": "HTTPS",
        "enablePathTransmission": true
      },
      {
        "path": "/api/health",
        "target": "function:ihealth-amazon-report-api",
        "protocol": "HTTPS",
        "enablePathTransmission": true
      },
      {
        "path": "/",
        "target": "hosting:ihealth-amazon-report-web",
        "protocol": "HTTPS"
      }
    ]
  }
}
