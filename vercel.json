{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/refresh.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "data/baseline-report.json"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
